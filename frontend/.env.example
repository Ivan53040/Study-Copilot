# Optional: copy this file to .env.production for a packaged desktop build.
# The desktop app tells the page its backend port at launch (8768, or a free
# port when that is taken), so this is only a fallback for older app shells.
# Vite exposes VITE_* values to the frontend, so never place secrets here.
VITE_API_BASE=http://127.0.0.1:8768
